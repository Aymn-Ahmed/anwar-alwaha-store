# Anwar Al Wahah Storefront & Admin - Environment Configuration
# API Base URL (Leave empty or set to /api when using Vite proxy in local development)
VITE_API_BASE_URL=http://localhost:5000/api

# Moyasar Publishable Key for Frontend Checkout Form (Optional override, fallback comes from backend /api/payments/initiate)
VITE_MOYASAR_PUBLISHABLE_KEY=pk_test_sample_key_for_anwar_alwaha_library
